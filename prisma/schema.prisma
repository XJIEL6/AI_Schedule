generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Version {
  id         BigInt    @id @default(autoincrement())
  name       String    @unique @db.VarChar(50)
  brdDate    DateTime  @map("brd_date") @db.Date
  launchDate DateTime  @map("launch_date") @db.Date
  sortOrder  Int       @default(0) @map("sort_order")
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  @@map("versions")
}

model Holiday {
  id        BigInt    @id @default(autoincrement())
  startDate DateTime  @map("start_date") @db.Date
  endDate   DateTime  @map("end_date") @db.Date
  type      String    @default("holiday") @db.VarChar(20)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  @@map("holidays")
}

model NoRelease {
  id        BigInt    @id @default(autoincrement())
  startDate DateTime  @map("start_date") @db.Date
  endDate   DateTime  @map("end_date") @db.Date
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  @@map("no_release")
}

model EmailConfig {
  id         Int       @id @default(1)
  smtpHost   String    @default("") @map("smtp_host") @db.VarChar(255)
  smtpPort   Int       @default(465) @map("smtp_port")
  smtpUser   String    @default("") @map("smtp_user") @db.VarChar(255)
  smtpPass   String    @default("") @map("smtp_pass") @db.VarChar(255)
  recipients String    @default("") @db.VarChar(500)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  @@map("email_config")
}

model Conversation {
  id        BigInt         @id @default(autoincrement())
  title     String         @default("New Conversation") @db.VarChar(200)
  messages  ChatMessage[]
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  @@map("conversations")
}

model ChatMessage {
  id             BigInt       @id @default(autoincrement())
  conversationId BigInt       @map("conversation_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String       @db.VarChar(20)
  content        String       @db.Text
  toolCalls      Json?        @map("tool_calls") @db.JsonB
  label          String?      @db.VarChar(200)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz()
  @@map("chat_messages")
}

// 用户长期偏好（Agent 记忆层）
model UserPreference {
  id        Int      @id @default(autoincrement())
  key       String   @unique @db.VarChar(100)
  value     String   @db.Text
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  @@map("user_preferences")
}
